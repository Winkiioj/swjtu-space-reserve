<view class="page">
  <view class="header">
    <text class="title">📬 消息通知</text>
    <view wx:if="{{notifications.length > 0}}" class="mark-all" bindtap="markAllRead">全部已读</view>
  </view>

  <view wx:if="{{showEmpty && !loading}}" class="empty">
    <text class="empty-icon">🔔</text>
    <text class="empty-text">暂无通知消息</text>
  </view>

  <view
    wx:for="{{notifications}}"
    wx:for-item="n"
    wx:key="_id"
    class="notif-item {{n.isRead ? '' : 'unread'}}"
    data-id="{{n._id}}"
    data-read="{{n.isRead}}"
    bindtap="onNotifTap"
  >
    <text class="n-icon">{{n._icon}}</text>
    <view class="n-body">
      <view class="n-top">
        <text class="n-title">{{n.title}}</text>
        <text class="n-time">{{n._time}}</text>
      </view>
      <text class="n-content">{{n.content}}</text>
    </view>
    <view wx:if="{{!n.isRead}}" class="n-dot"></view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{!hasMore && notifications.length > 0}}" class="no-more">— 没有更多了 —</view>
</view>
