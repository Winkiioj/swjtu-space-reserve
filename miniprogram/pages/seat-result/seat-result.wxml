<view class="container">

  <!-- 顶部摘要 -->
  <view class="section" style="padding:24rpx 32rpx;">
    <view style="display:flex;align-items:center;justify-content:space-between;">
      <view>
        <text style="font-size:28rpx;color:#888;">📅 {{dayType === 'this' ? '今天' : '明天'}} · 已选 {{selectedLectures.length}} 个讲次</text>
      </view>
      <view class="header-link" bindtap="goBack" style="font-size:26rpx;">← 返回修改</view>
    </view>
  </view>

  <!-- 楼层 + 区域筛选 -->
  <view wx:if="{{seatsRaw.length > 0}}" class="section filter-section">
    <view class="section-header">
      <text class="section-icon">🔎</text>
      <text class="section-title">筛选楼层和区域</text>
      <text class="section-count">{{seatsRaw.length}} 个空闲座位</text>
    </view>

    <!-- 常用座位 -->
    <view wx:if="{{favorites.length > 0}}" class="filter-row" style="margin-bottom:24rpx;padding-bottom:20rpx;border-bottom:2rpx solid #f5f5f5;">
      <text class="filter-label">⭐</text>
      <view class="filter-options">
        <view wx:for="{{favorites}}" wx:key="value"
              class="filter-tag filter-tag-active"
              style="background:linear-gradient(135deg,#ff9800 0%,#ffb74d 100%);border-color:#ff9800;color:#fff;"
              data-fav="{{item}}" bindtap="loadFavorite">
          {{item.label}}
        </view>
      </view>
    </view>

    <!-- 楼层 -->
    <view class="filter-row">
      <text class="filter-label">楼层</text>
      <view class="filter-options">
        <view wx:for="{{floors}}" wx:key="*this"
              class="filter-tag {{currentFloor === item ? 'filter-tag-active' : ''}}"
              bindtap="selectFloor" data-floor="{{item}}">
          {{item}} 楼
        </view>
      </view>
    </view>
    <!-- 区域 -->
    <view class="filter-row" wx:if="{{currentFloorAreas.length > 0}}">
      <text class="filter-label">区域</text>
      <view class="filter-options">
        <view wx:for="{{currentFloorAreas}}" wx:key="*this"
              class="filter-tag {{currentArea === item ? 'filter-tag-active' : ''}}"
              bindtap="selectArea" data-area="{{item}}">
          {{item}} 区
        </view>
      </view>
    </view>
    <view style="display:flex;gap:16rpx;margin-top:12rpx;">
      <button class="filter-btn" style="flex:1;" bindtap="loadAreaMap">🗺️ 查看座位图</button>
      <view class="{{isCurrentFav ? 'fav-btn-active' : 'fav-btn'}}" bindtap="toggleFavorite">
        <text>{{isCurrentFav ? '★' : '☆'}} 收藏</text>
      </view>
    </view>
  </view>

  <!-- ===== 座位可视化地图 ===== -->
  <view wx:if="{{showMap && mapSeats.length > 0}}" class="section map-section">
    <view class="map-top-bar">
      <text class="map-title">🗺️ {{mapAreaLabel}} 区</text>
      <view class="map-legend">
        <view class="legend-item"><view class="legend-dot dot-free"></view><text>空闲</text></view>
        <view class="legend-item"><view class="legend-dot dot-occ"></view><text>已占</text></view>
      </view>
    </view>

    <view class="map-room">
      <view class="room-wall room-wall-top">
        <view class="wall-line"></view>
        <view class="wall-window">🪟 窗户</view>
        <view class="wall-line"></view>
      </view>
      <view class="room-body">
        <view class="wall-side wall-left"></view>
        <view class="room-grid">
          <view wx:for="{{mapSeats}}" wx:key="_id"
                class="room-seat {{item.isAvailable ? 'seat-free' : 'seat-occ'}}"
                data-seat="{{item}}"
                bindtap="{{item.isAvailable ? 'reserveSeat' : ''}}">
            <view class="seat-block">
              <text class="seat-block-num">{{item.seatID.slice(-2)}}号</text>
            </view>
            <text class="seat-block-status">{{item.isAvailable ? '空闲' : '已占'}}</text>
          </view>
        </view>
        <view class="wall-side wall-right"></view>
      </view>
      <view class="room-wall room-wall-bottom">
        <view class="wall-line"></view>
        <view class="wall-door">🚪 入口</view>
        <view class="wall-line"></view>
      </view>
      <view class="map-lecture-hint">
        <text>已选 {{selectedLectures.length}} 个讲次 · 点击空闲座位预约</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{showMap && mapSeats.length === 0}}" class="empty-state">
    <text class="empty-icon">🪑</text>
    <text class="empty-text">该区域暂无座位数据</text>
    <text class="empty-hint">请尝试切换楼层或区域</text>
  </view>

  <view wx:elif="{{seatsRaw.length === 0 && queried}}" class="empty-state">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无空闲座位</text>
    <text class="empty-hint">请更换讲次或日期后重试</text>
  </view>
</view>
