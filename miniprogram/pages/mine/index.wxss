.page { min-height: 100vh; background: #f5f6fa; padding-bottom: 48rpx; }

/* 用户卡片 */
.user-card {
  display: flex; align-items: center;
  margin: 24rpx; padding: 32rpx 24rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; }
.avatar-place {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #f0f5ff; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}

.user-body { flex: 1; margin-left: 24rpx; }
.name { font-size: 32rpx; font-weight: 600; color: #1a1a1a; display: block; }
.uid { font-size: 24rpx; color: #8c8c8c; display: block; margin-top: 6rpx; }
.uid.warn { color: #fa8c16; }

.bind-btn {
  font-size: 24rpx; color: #1677ff;
  padding: 12rpx 24rpx; border: 1rpx solid #1677ff;
  border-radius: 32rpx;
}

/* 统计 */
.stats { display: flex; margin: 0 24rpx 24rpx; }
.stat {
  flex: 1; text-align: center; padding: 24rpx 0;
  background: #fff; border-radius: 12rpx; margin: 0 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.stat:first-child { margin-left: 0; }
.stat:last-child { margin-right: 0; }
.num { font-size: 40rpx; font-weight: 700; color: #1a1a1a; display: block; }
.num.green { color: #52c41a; } .num.yellow { color: #faad14; } .num.red { color: #ff4d4f; }
.label { font-size: 22rpx; color: #8c8c8c; margin-top: 8rpx; display: block; }

/* 菜单 */
.menu {
  margin: 0 24rpx 16rpx; background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); overflow: hidden;
}

.menu-item {
  display: flex; align-items: center; padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-item.logout { border-top: 8rpx solid #f5f6fa; border-bottom: none; }

.mi-icon { font-size: 32rpx; margin-right: 20rpx; width: 48rpx; text-align: center; }
.mi-text { flex: 1; font-size: 28rpx; color: #333; }
.mi-arrow { font-size: 28rpx; color: #c0c0c0; }

.menu-item.logout .mi-text { color: #ff4d4f; }

.version { text-align: center; font-size: 22rpx; color: #c0c0c0; padding: 32rpx 0; display: block; }

button::after { display: none; }
