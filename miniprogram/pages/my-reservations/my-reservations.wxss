.container {
  padding: 0 30rpx 40rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.page-header {
  padding: 30rpx 0;
}
.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* 加载中 */
.loading-state {
  padding: 200rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 28rpx;
  color: #bbb;
}

/* 预约卡片 */
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.reservation-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-seat-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.card-seat-id {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.card-area {
  font-size: 26rpx;
  color: #999;
}
.card-status {
  font-size: 24rpx;
  font-weight: 500;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.status-active {
  background: #e8f8ee;
  color: #07c160;
}

.card-divider {
  height: 2rpx;
  background: #f5f5f5;
  margin: 20rpx 0;
}

.card-detail {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.detail-row {
  display: flex;
  align-items: flex-start;
}
.detail-label {
  width: 80rpx;
  font-size: 26rpx;
  color: #bbb;
  flex-shrink: 0;
}
.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: #555;
}
.detail-lectures {
  line-height: 1.6;
}

.cancel-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #fff;
  color: #ff4d4f;
  font-size: 28rpx;
  border: 2rpx solid #ffd9d9;
  border-radius: 36rpx;
  margin-top: 20rpx;
  padding: 0;
}
.cancel-btn:active {
  background: #fff2f0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #888;
  font-weight: 500;
}
.empty-hint {
  font-size: 26rpx;
  color: #ccc;
  margin-top: 10rpx;
}
