<view class="page">
  <view class="logo-area">
    <text class="logo-icon">🏫</text>
    <text class="title">教室预约管理系统</text>
    <text class="subtitle">管理员登录</text>
  </view>

  <view class="form">
    <view class="input-group">
      <text class="input-label">工号/学号</text>
      <input
        class="input"
        type="text"
        placeholder="请输入您的工号或学号"
        value="{{userID}}"
        bindinput="onInput"
        maxlength="50"
      />
    </view>

    <view class="login-btn {{loading ? 'login-btn-disabled' : ''}}" hover-class="login-btn-active" bindtap="{{loading ? '' : 'doLogin'}}">
      <text>{{loading ? '登录中...' : '登 录'}}</text>
    </view>
  </view>

  <view class="back-home" bindtap="goHome">
    <text class="back-home-icon">🏠</text>
    <text class="back-home-text">返回学生端首页</text>
  </view>

  <view class="footer">
    <text>© 交大教室租借系统</text>
  </view>
</view>
