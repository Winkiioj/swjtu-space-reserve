@import '../../../styles/admin-theme.wxss';

.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--adm-border);
}

.radio-item:last-child {
  border-bottom: none;
}

.radio-content {
  margin-left: 16rpx;
  flex: 1;
}

.radio-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--adm-text-primary);
}

.radio-capacity {
  display: block;
  font-size: 24rpx;
  color: var(--adm-text-secondary);
  margin-top: 4rpx;
}

.action-buttons {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}
