@import '../../../styles/admin-theme.wxss';

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--adm-card-bg);
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.s-icon { font-size: 28rpx; margin-right: 12rpx; }
.s-input {
  flex: 1;
  font-size: 26rpx;
  height: 48rpx;
  color: var(--adm-text-primary);
}
.s-clear {
  font-size: 28rpx;
  color: var(--adm-text-muted);
  padding: 8rpx;
}
.s-hint {
  font-size: 22rpx;
  color: var(--adm-text-secondary);
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* ========== 申请卡片 ========== */
.app-card {
  background: var(--adm-card-bg);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  overflow: hidden;
  transition: all 0.2s;
}
.app-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 顶栏 */
.app-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f0f2f5;
}

.app-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.app-avatar {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #4a6cf7 0%, #6a8cff 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.app-user-info {
  display: flex;
  flex-direction: column;
}

.app-user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--adm-text-primary);
}

.app-user-id {
  font-size: 20rpx;
  color: var(--adm-text-muted);
  margin-top: 2rpx;
}

.app-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

/* 状态标签 */
.tag-status {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 500;
  white-space: nowrap;
}
.tag-pending { background: #fef3c7; color: #d97706; }
.tag-approved { background: #d1fae5; color: #059669; }
.tag-rejected { background: #fee2e2; color: #dc2626; }

.tag-revoke {
  font-size: 20rpx;
  color: #d97706;
  background: #fef3c7;
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

/* 卡片内容 */
.app-card-body {
  padding: 20rpx 28rpx;
}

.app-info-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.app-info-item + .app-info-item {
  border-top: 2rpx solid #f5f6f8;
}

.app-info-icon {
  width: 36rpx;
  text-align: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.app-info-text {
  font-size: 26rpx;
  color: var(--adm-text-primary);
  line-height: 1.4;
}

.app-info-detail {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 底部状态 ========== */
.adm-loading {
  text-align: center;
  padding: 40rpx 0;
  color: var(--adm-text-muted);
  font-size: 26rpx;
}

.adm-no-more {
  text-align: center;
  padding: 30rpx 0;
  color: var(--adm-text-muted);
  font-size: 24rpx;
}

.adm-empty {
  padding: 60rpx 0 !important;
}
