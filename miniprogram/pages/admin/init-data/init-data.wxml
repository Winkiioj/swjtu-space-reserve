<view class="adm-page">
  <!-- ===== 一键重置测试环境 ===== -->
  <view class="adm-card reset-card">
    <view class="adm-section-title">⚡ 一键重置测试环境</view>
    <text style="font-size: 26rpx; color: var(--adm-text-secondary); display: block; margin-bottom: 24rpx;">
      清空并重建全部测试数据：教室(20间) + 用户(11人) + 申请(10条) + 座位(180个)。重置前请确保云函数已部署。
    </text>

    <!-- 未开始 -->
    <view wx:if="{{!resetRunning && !resetDone}}">
      <view class="adm-btn adm-btn-danger" hover-class="adm-btn-active" bindtap="startReset">一键重置全部数据</view>
    </view>

    <!-- 执行中 -->
    <view wx:if="{{resetRunning}}" class="reset-progress">
      <view class="reset-step" wx:for="{{resetSteps}}" wx:key="name">
        <text class="reset-step-icon">
          {{item.status === 'wait' ? '○' : ''}}
          {{item.status === 'running' ? '⏳' : ''}}
          {{item.status === 'done' ? '✅' : ''}}
          {{item.status === 'fail' ? '❌' : ''}}
        </text>
        <text class="reset-step-name {{item.status}}">{{item.name}}</text>
        <text class="reset-step-status">
          {{item.status === 'wait' ? '等待' : ''}}
          {{item.status === 'running' ? '执行中...' : ''}}
          {{item.status === 'done' ? '完成' : ''}}
          {{item.status === 'fail' ? '失败' : ''}}
        </text>
      </view>
    </view>

    <!-- 完成 -->
    <view wx:if="{{resetDone && resetSummary}}" class="reset-summary">
      <text class="reset-summary-title">✅ 重置完成</text>
      <text class="reset-summary-text">{{resetSummary}}</text>
      <view class="adm-btn adm-btn-primary" hover-class="adm-btn-active" bindtap="startReset" style="margin-top: 20rpx;">再次重置</view>
    </view>
  </view>

  <!-- ===== 教室导入表单 ===== -->
  <view class="adm-card">
    <view class="adm-section-title">📚 导入教室数据</view>
    <text style="font-size: 26rpx; color: var(--adm-text-secondary); display: block; margin-bottom: 32rpx;">
      选择教学楼、楼层、编号范围和教室属性，批量生成教室。
    </text>

    <!-- 教学楼 -->
    <view class="form-row">
      <text class="form-label">教学楼</text>
      <picker mode="selector" range="{{buildings}}" value="{{selectedBuildingIndex}}" bindchange="onBuildingChange">
        <view class="form-picker">
          <text>{{buildings[selectedBuildingIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 楼层 -->
    <view class="form-row">
      <text class="form-label">楼层</text>
      <picker mode="selector" range="{{floors}}" value="{{selectedFloorIndex}}" bindchange="onFloorChange">
        <view class="form-picker">
          <text>{{floors[selectedFloorIndex]}} 楼</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 编号范围 -->
    <view class="form-row">
      <text class="form-label">编号范围</text>
      <view class="form-range">
        <input class="range-input" type="number" value="{{roomStart}}" bindinput="onRoomStartInput" maxlength="2" placeholder="01" />
        <text style="color: var(--adm-text-muted); margin: 0 12rpx;">至</text>
        <input class="range-input" type="number" value="{{roomEnd}}" bindinput="onRoomEndInput" maxlength="2" placeholder="05" />
      </view>
    </view>

    <!-- 容量 -->
    <view class="form-row">
      <text class="form-label">容量</text>
      <picker mode="selector" range="{{capacityOptions}}" value="{{selectedCapacityIndex}}" bindchange="onCapacityChange">
        <view class="form-picker">
          <text>{{capacityOptions[selectedCapacityIndex]}} 人</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 教室类型 -->
    <view class="form-row">
      <text class="form-label">教室类型</text>
      <picker mode="selector" range="{{roomTypes}}" value="{{selectedRoomTypeIndex}}" bindchange="onRoomTypeChange">
        <view class="form-picker">
          <text>{{roomTypes[selectedRoomTypeIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 设施 -->
    <view class="form-row">
      <text class="form-label">设施设备（多选）</text>
      <view class="facility-grid">
        <view
          class="facility-chip {{facilityChecked[item.key] ? 'on' : ''}}"
          wx:for="{{facilityOptions}}"
          wx:key="key"
          bindtap="onFacilityToggle"
          data-key="{{item.key}}"
        >
          <text>{{facilityChecked[item.key] ? '✓ ' : ''}}{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 描述 -->
    <view class="form-row" style="border-bottom: none;">
      <text class="form-label">描述（可选）</text>
      <input class="form-input" type="text" value="{{description}}" bindinput="onDescInput" placeholder="如：配备投影仪和智慧白板" />
    </view>

    <!-- 生成按钮 -->
    <view class="form-actions">
      <view class="btn-generate" hover-class="btn-generate-active" bindtap="generateClassrooms">添加教室批次</view>
      <view class="btn-generate" hover-class="btn-generate-active" style="margin-top: 16rpx; background: var(--adm-text-secondary);" bindtap="showClassroomImport">JSON导入教室</view>
    </view>
  </view>

  <!-- ===== 待导入列表 ===== -->
  <view wx:if="{{classroomList.length}}" class="adm-card">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
      <text style="font-size: 28rpx; font-weight: 600; color: var(--adm-text-primary);">待导入教室（{{classroomList.length}} 间）</text>
      <text style="font-size: 24rpx; color: var(--adm-danger);" bindtap="clearList">清空</text>
    </view>

    <scroll-view scroll-y style="max-height: 400rpx;">
      <view class="preview-item" wx:for="{{classroomList}}" wx:for-index="i" wx:key="index">
        <view class="preview-info">
          <text class="preview-building">{{item.buildingBelong}}</text>
          <text class="preview-room">{{item.classroomID}}</text>
          <text class="preview-type" wx:if="{{item.roomType}}" style="font-size: 22rpx; color: var(--adm-primary); margin-right: 8rpx;">{{item.roomType}}</text>
          <text class="preview-capacity">{{item.containNumber}}人</text>
        </view>
        <text class="preview-remove" bindtap="removeItem" data-index="{{i}}">✕</text>
      </view>
    </scroll-view>

    <view class="adm-btn adm-btn-primary {{importing ? 'adm-btn-disabled' : ''}}" hover-class="adm-btn-active" bindtap="onBatchImport" style="margin-top: 20rpx;">
      {{importing ? '导入中...' : '确认导入 ' + classroomList.length + ' 间教室'}}
    </view>
  </view>

  <!-- ===== 教室 JSON 粘贴弹框 ===== -->
  <view wx:if="{{showClassroomModal}}" class="modal-overlay" catchtouchmove="noop">
    <view class="modal-content">
      <text class="modal-title">粘贴教室 JSON</text>
      <scroll-view scroll-y class="modal-scroll">
        <textarea class="modal-textarea" value="{{classroomJson}}" bindinput="onClassroomJsonInput" placeholder='[{"buildingBelong":"一号教学楼","classroomID":"x1101","containNumber":90,"roomType":"多媒体教室","facilities":["投影仪","空调"],"description":"配备投影仪"}]' maxlength="-1" />
      </scroll-view>
      <view class="modal-actions">
        <view class="adm-btn adm-btn-outline" hover-class="adm-btn-active" bindtap="closeClassroomModal" style="flex:1;">取消</view>
        <view class="adm-btn adm-btn-primary {{importing ? 'adm-btn-disabled' : ''}}" hover-class="adm-btn-active" bindtap="onJsonImport" style="flex:1; margin-left: 20rpx;">
          {{importing ? '导入中...' : '确认导入'}}
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 课表导入（入口保留） ===== -->
  <view class="adm-card">
    <view class="adm-section-title">📖 导入课表数据</view>
    <text style="font-size: 26rpx; color: var(--adm-text-secondary); display: block; margin-bottom: 24rpx;">
      粘贴课表 JSON 数据，系统将自动标记教室占用讲次。
    </text>
    <view class="adm-btn adm-btn-outline" hover-class="adm-btn-active" bindtap="showCourseImport">导入课表</view>
  </view>

  <!-- ===== 课表 JSON 粘贴弹框 ===== -->
  <view wx:if="{{showCourseModal}}" class="modal-overlay" catchtouchmove="noop">
    <view class="modal-content">
      <text class="modal-title">粘贴课表 JSON</text>
      <scroll-view scroll-y class="modal-scroll">
        <textarea class="modal-textarea" value="{{courseJson}}" bindinput="onCourseJsonInput" placeholder='[{"classroomID":"x2101","courseID":"CS101","courseName":"高等数学","schedule":{"dayOfWeek":0,"startLecture":0,"endLecture":2}}]' maxlength="-1" />
      </scroll-view>
      <view class="modal-actions">
        <view class="adm-btn adm-btn-outline" hover-class="adm-btn-active" bindtap="closeCourseModal" style="flex:1;">取消</view>
        <view class="adm-btn adm-btn-primary {{importingCourses ? 'adm-btn-disabled' : ''}}" hover-class="adm-btn-active" bindtap="onCourseImport" style="flex:1; margin-left: 20rpx;">
          {{importingCourses ? '导入中...' : '确认导入'}}
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 导入日志 ===== -->
  <view wx:if="{{logs.length}}" class="adm-card">
    <text style="font-size: 28rpx; font-weight: 600; color: var(--adm-text-primary); display: block; margin-bottom: 16rpx;">操作记录</text>
    <view wx:for="{{logs}}" wx:for-index="i" wx:key="i">
      <text style="font-size: 24rpx; color: var(--adm-success); line-height: 1.8; display: block;">{{item}}</text>
    </view>
  </view>
</view>
