@import '../../../styles/admin-theme.wxss';

/* ===== 表单行 ===== */
.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--adm-border);
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--adm-text-primary);
  font-weight: 500;
  flex-shrink: 0;
}

.form-picker {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--adm-bg);
  border-radius: var(--adm-radius-sm);
  font-size: 28rpx;
  color: var(--adm-text-primary);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--adm-text-muted);
}

.form-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--adm-bg);
  border-radius: var(--adm-radius-sm);
  font-size: 28rpx;
}

.form-range {
  flex: 1;
  display: flex;
  align-items: center;
}

.range-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: var(--adm-bg);
  border-radius: var(--adm-radius-sm);
  font-size: 28rpx;
  text-align: center;
}

/* 设施多选网格 */
.facility-grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.facility-chip {
  padding: 12rpx 22rpx;
  background: var(--adm-bg);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--adm-text-secondary);
  transition: all 0.15s;
  display: flex;
  align-items: center;
}

.facility-chip.on {
  background: var(--adm-primary);
  color: #fff;
}

/* ===== 操作按钮 ===== */
.form-actions {
  margin-top: 28rpx;
}

.btn-generate {
  width: 100%;
  height: 80rpx;
  background: var(--adm-primary);
  color: #fff;
  border-radius: var(--adm-radius-lg);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-generate-active {
  opacity: 0.85;
}

/* ===== 预览列表 ===== */
.preview-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--adm-border);
}

.preview-item:last-child {
  border-bottom: none;
}

.preview-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-building {
  font-size: 26rpx;
  color: var(--adm-text-primary);
  background: var(--adm-primary-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.preview-room {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--adm-text-primary);
}

.preview-capacity {
  font-size: 24rpx;
  color: var(--adm-text-secondary);
}

.preview-remove {
  font-size: 28rpx;
  color: var(--adm-danger);
  padding: 8rpx 16rpx;
}

/* ===== 课表粘贴弹框 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--adm-text-primary);
  margin-bottom: 24rpx;
}

.modal-scroll {
  max-height: 500rpx;
  margin-bottom: 24rpx;
}

.modal-textarea {
  width: 100%;
  height: 400rpx;
  padding: 20rpx;
  background: var(--adm-bg);
  border-radius: var(--adm-radius-sm);
  font-size: 24rpx;
  color: var(--adm-text-primary);
  box-sizing: border-box;
  line-height: 1.6;
  font-family: monospace;
}

.modal-actions {
  display: flex;
  margin-top: 32rpx;
}

/* ===== 一键重置 ===== */
.reset-card {
  border-left: 6rpx solid #f5222d;
}

.reset-progress {
  margin-top: 8rpx;
}

.reset-step {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--adm-border);
  gap: 14rpx;
}

.reset-step:last-child {
  border-bottom: none;
}

.reset-step-icon {
  font-size: 28rpx;
  width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.reset-step-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--adm-text-primary);
}

.reset-step-name.running {
  font-weight: 600;
  color: var(--adm-primary);
}

.reset-step-name.fail {
  color: var(--adm-danger);
}

.reset-step-status {
  font-size: 22rpx;
  color: var(--adm-text-muted);
  flex-shrink: 0;
}

.reset-summary {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f6ffed;
  border-radius: var(--adm-radius-sm);
  border: 1rpx solid #b7eb8f;
}

.reset-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #389e0d;
  display: block;
  margin-bottom: 12rpx;
}

.reset-summary-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-line;
  display: block;
}
