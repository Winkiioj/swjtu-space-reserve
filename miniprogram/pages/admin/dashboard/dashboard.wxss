@import '../../../styles/admin-theme.wxss';

/* ========== 欢迎卡片 ========== */
.welcome-card {
  background: linear-gradient(135deg, #4a6cf7 0%, #3b5de7 100%);
  border-radius: var(--adm-radius-md);
  padding: 36rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 108, 247, 0.25);
}

.welcome-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.welcome-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* ========== 统计卡片 ========== */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  background: var(--adm-card-bg);
  border-radius: var(--adm-radius-md);
  padding: 20rpx 0;
  text-align: center;
  box-shadow: var(--adm-shadow);
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--adm-text-secondary);
  margin-top: 6rpx;
}

/* ========== 图表卡片 ========== */
.chart-card {
  background: var(--adm-card-bg);
  border-radius: var(--adm-radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--adm-shadow);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--adm-text-primary);
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid var(--adm-primary);
}

.chart-container {
  width: 100%;
  height: 360rpx;
  position: relative;
}

.trend-canvas {
  width: 100%;
  height: 350rpx;
}

/* ========== 热力图 ========== */
.heatmap-wrapper {
  overflow-x: auto;
  padding: 10rpx 0;
}

.heatmap-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.heatmap-corner {
  width: 80rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.heatmap-col-header {
  width: 62rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 4rpx;
}

.heatmap-header-text {
  font-size: 18rpx;
  color: var(--adm-text-muted);
  transform: rotate(-30deg);
  white-space: nowrap;
}

.heatmap-row-label {
  width: 80rpx;
  font-size: 22rpx;
  color: var(--adm-text-secondary);
  text-align: center;
  flex-shrink: 0;
}

.heatmap-cell {
  width: 62rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  margin-right: 4rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.heatmap-cell:active {
  transform: scale(1.05);
}

.heatmap-cell-text {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* 图例 */
.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--adm-border);
}

.legend-label {
  font-size: 20rpx;
  color: var(--adm-text-muted);
}

.legend-bar {
  display: flex;
  gap: 2rpx;
}

.legend-step {
  width: 32rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

/* ========== 通知铃铛 ========== */
.notif-bell {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.notif-bell:active {
  background: rgba(255, 255, 255, 0.25);
}

.notif-bell-icon {
  font-size: 36rpx;
}

.notif-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 6rpx;
  border: 2rpx solid #fff;
}

/* ========== 快捷操作 ========== */
.quick-menu {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.menu-item {
  flex: 1;
  background: var(--adm-card-bg);
  border-radius: var(--adm-radius-lg);
  padding: 36rpx 0;
  text-align: center;
  box-shadow: var(--adm-shadow);
}

.menu-item:active {
  opacity: 0.8;
  transform: scale(0.97);
}

.menu-icon {
  display: block;
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.menu-text {
  font-size: 28rpx;
  color: var(--adm-text-primary);
  font-weight: 500;
}
