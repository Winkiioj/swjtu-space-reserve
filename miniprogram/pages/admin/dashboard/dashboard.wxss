@import '../../../styles/admin-theme.wxss';

/* ========== 首页仪表盘 ========== */
.welcome-card {
  background: linear-gradient(135deg, #4a6cf7 0%, #3b5de7 100%);
  border-radius: var(--adm-radius-md);
  padding: 36rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 108, 247, 0.25);
}
.welcome-row { display: flex; justify-content: space-between; align-items: flex-start; }
.welcome-title { font-size: 36rpx; font-weight: 700; color: #fff; display: block; margin-bottom: 8rpx; }
.welcome-date { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); display: block; }

.stats-grid { display: flex; gap: 16rpx; margin-bottom: 30rpx; }
.stat-card {
  flex: 1; background: var(--adm-card-bg); border-radius: var(--adm-radius-md);
  padding: 20rpx 0; text-align: center; box-shadow: var(--adm-shadow);
}
.stat-num { display: block; font-size: 44rpx; font-weight: 700; }
.stat-label { display: block; font-size: 22rpx; color: var(--adm-text-secondary); margin-top: 6rpx; }

.chart-card {
  background: var(--adm-card-bg); border-radius: var(--adm-radius-md);
  padding: 24rpx; margin-bottom: 24rpx; box-shadow: var(--adm-shadow);
}
.chart-title {
  font-size: 28rpx; font-weight: 600; color: var(--adm-text-primary);
  margin-bottom: 20rpx; padding-left: 10rpx; border-left: 6rpx solid var(--adm-primary);
}
.chart-container { width: 100%; height: 620rpx; position: relative; }
.trend-canvas { width: 100%; height: 600rpx; }

.heatmap-wrapper { overflow-x: auto; padding: 10rpx 0; }
.heatmap-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.heatmap-corner { width: 80rpx; height: 36rpx; flex-shrink: 0; }
.heatmap-col-header { width: 62rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 4rpx; }
.heatmap-header-text { font-size: 18rpx; color: var(--adm-text-muted); transform: rotate(-30deg); white-space: nowrap; }
.heatmap-row-label { width: 80rpx; font-size: 22rpx; color: var(--adm-text-secondary); text-align: center; flex-shrink: 0; }
.heatmap-cell {
  width: 62rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 6rpx; margin-right: 4rpx; flex-shrink: 0; transition: all 0.2s;
}
.heatmap-cell:active { transform: scale(1.05); }
.heatmap-cell-text { font-size: 16rpx; color: rgba(255,255,255,0.9); font-weight: 500; }
.heatmap-legend {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid var(--adm-border);
}
.legend-label { font-size: 20rpx; color: var(--adm-text-muted); }
.legend-bar { display: flex; gap: 2rpx; }
.legend-step { width: 32rpx; height: 24rpx; border-radius: 4rpx; }

.notif-bell {
  position: relative; width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.15); border-radius: 50%;
}
.notif-bell:active { background: rgba(255,255,255,0.25); }
.notif-bell-icon { font-size: 36rpx; }
.notif-badge {
  position: absolute; top: -4rpx; right: -4rpx; min-width: 32rpx; height: 32rpx;
  line-height: 32rpx; text-align: center; background: #ef4444; color: #fff;
  font-size: 18rpx; font-weight: 600; border-radius: 16rpx; padding: 0 6rpx; border: 2rpx solid #fff;
}

.tabbar-badge {
  position: absolute; top: 0; right: 50%; transform: translateX(200%);
  min-width: 28rpx; height: 28rpx; line-height: 28rpx; text-align: center;
  background: #ef4444; color: #fff; font-size: 16rpx; font-weight: 600;
  border-radius: 14rpx; padding: 0 6rpx;
}

.quick-menu { display: flex; gap: 24rpx; margin-top: 20rpx; margin-bottom: 40rpx; }
.menu-item {
  flex: 1; background: var(--adm-card-bg); border-radius: var(--adm-radius-lg);
  padding: 36rpx 0; text-align: center; box-shadow: var(--adm-shadow);
}
.menu-item:active { opacity: 0.8; transform: scale(0.97); }
.menu-icon { display: block; font-size: 56rpx; margin-bottom: 12rpx; }
.menu-text { font-size: 28rpx; color: var(--adm-text-primary); font-weight: 500; }

/* ========== 审核列表 ========== */
.review-subtab {
  display: flex; background: var(--adm-card-bg); border-radius: 24rpx;
  margin-bottom: 24rpx; overflow: hidden; box-shadow: var(--adm-shadow);
}
.review-subtab-item {
  flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx;
  color: var(--adm-text-secondary); transition: all 0.2s; position: relative;
}
.review-subtab-item.active {
  color: var(--adm-primary); font-weight: 600;
}
.review-subtab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 20%; right: 20%;
  height: 4rpx; background: var(--adm-primary); border-radius: 2rpx;
}

.search-bar {
  display: flex; align-items: center; background: var(--adm-card-bg);
  border-radius: 50rpx; padding: 16rpx 24rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.s-icon { font-size: 28rpx; margin-right: 12rpx; }
.s-input { flex: 1; font-size: 26rpx; height: 48rpx; color: var(--adm-text-primary); }
.s-clear { font-size: 28rpx; color: var(--adm-text-muted); padding: 8rpx; }

.app-card {
  background: var(--adm-card-bg); border-radius: 24rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); overflow: hidden; transition: all 0.2s;
}
.app-card:active { transform: scale(0.98); opacity: 0.9; }
.app-card-top {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 28rpx; border-bottom: 2rpx solid #f0f2f5;
}
.app-user { display: flex; align-items: center; gap: 14rpx; }
.app-avatar {
  width: 56rpx; height: 56rpx; background: linear-gradient(135deg, #4a6cf7 0%, #6a8cff 100%);
  color: #fff; font-size: 24rpx; font-weight: 600; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.app-user-info { display: flex; flex-direction: column; }
.app-user-name { font-size: 28rpx; font-weight: 600; color: var(--adm-text-primary); }
.app-user-id { font-size: 20rpx; color: var(--adm-text-muted); margin-top: 2rpx; }
.app-status { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }

.tag-status { font-size: 20rpx; padding: 6rpx 18rpx; border-radius: 30rpx; font-weight: 500; white-space: nowrap; }
.tag-pending { background: #fef3c7; color: #d97706; }
.tag-approved { background: #d1fae5; color: #059669; }
.tag-rejected { background: #fee2e2; color: #dc2626; }
.tag-revoke { font-size: 20rpx; color: #d97706; background: #fef3c7; padding: 6rpx 14rpx; border-radius: 30rpx; white-space: nowrap; }

.app-card-body { padding: 20rpx 28rpx; }
.app-info-item { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 0; }
.app-info-item + .app-info-item { border-top: 2rpx solid #f5f6f8; }
.app-info-icon { width: 36rpx; text-align: center; font-size: 24rpx; flex-shrink: 0; }
.app-info-text { font-size: 26rpx; color: var(--adm-text-primary); line-height: 1.4; }
.app-info-detail { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ========== 通知列表 ========== */
.notif-header {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--adm-card-bg); border-radius: var(--adm-radius-md);
  padding: 24rpx 30rpx; margin-bottom: 20rpx; box-shadow: var(--adm-shadow);
}
.notif-header-left { display: flex; align-items: center; gap: 16rpx; }
.notif-title { font-size: 32rpx; font-weight: 700; color: var(--adm-text-primary); }
.notif-unread-badge { font-size: 20rpx; color: #fff; background: var(--adm-primary); padding: 4rpx 16rpx; border-radius: 20rpx; }
.notif-mark-all { font-size: 24rpx; color: var(--adm-primary); padding: 8rpx 16rpx; }
.notif-mark-all:active { opacity: 0.6; }

.notif-item {
  display: flex; gap: 16rpx; background: var(--adm-card-bg);
  border-radius: var(--adm-radius-md); padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: var(--adm-shadow);
}
.notif-item-unread { background: #f0f5ff; border-left: 6rpx solid var(--adm-primary); }
.notif-item:active { opacity: 0.8; }
.notif-icon { font-size: 36rpx; width: 48rpx; text-align: center; flex-shrink: 0; margin-top: 2rpx; }
.notif-body { flex: 1; min-width: 0; }
.notif-top { display: flex; align-items: center; gap: 8rpx; margin-bottom: 6rpx; }
.notif-title-text { font-size: 28rpx; font-weight: 600; color: var(--adm-text-primary); flex: 1; }
.notif-dot { width: 14rpx; height: 14rpx; background: var(--adm-primary); border-radius: 50%; flex-shrink: 0; }
.notif-content { display: block; font-size: 24rpx; color: var(--adm-text-secondary); line-height: 1.5; }

/* ========== 个人中心 ========== */
.profile-card {
  background: linear-gradient(135deg, #4a6cf7 0%, #3b5de7 100%);
  border-radius: var(--adm-radius-md); padding: 40rpx 30rpx; margin-bottom: 30rpx;
  display: flex; align-items: center; gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,108,247,0.25);
}
.profile-avatar {
  width: 100rpx; height: 100rpx; background: rgba(255,255,255,0.2);
  border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 52rpx;
}
.profile-info { flex: 1; }
.profile-name { display: block; font-size: 36rpx; font-weight: 700; color: #fff; }
.profile-role {
  display: inline-block; font-size: 20rpx; color: #fff;
  background: rgba(255,255,255,0.25); padding: 4rpx 16rpx; border-radius: 20rpx; margin-top: 8rpx;
}
.profile-id { display: block; font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; }

.menu-list { background: var(--adm-card-bg); border-radius: var(--adm-radius-md); overflow: hidden; box-shadow: var(--adm-shadow); }
.menu-item-row {
  display: flex; align-items: center; padding: 28rpx 30rpx; border-bottom: 2rpx solid var(--adm-border);
}
.menu-item-row:last-child { border-bottom: none; }
.menu-item-row:active { background: #f8f9fb; }
.menu-item-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-item-label { flex: 1; font-size: 28rpx; color: var(--adm-text-primary); }
.menu-item-arrow { font-size: 36rpx; color: var(--adm-text-muted); }

.logout-btn {
  margin-top: 60rpx; height: 88rpx; line-height: 88rpx; text-align: center;
  background: var(--adm-card-bg); border-radius: var(--adm-radius-lg);
  color: var(--adm-danger); font-size: 30rpx; font-weight: 500; box-shadow: var(--adm-shadow);
}
.logout-btn:active { opacity: 0.7; }

/* ========== 公用 ========== */
.adm-loading { text-align: center; padding: 40rpx 0; color: var(--adm-text-muted); font-size: 26rpx; }
.adm-no-more { text-align: center; padding: 30rpx 0; color: var(--adm-text-muted); font-size: 24rpx; }
.adm-empty { padding: 60rpx 0 !important; }
