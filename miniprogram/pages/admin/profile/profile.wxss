@import '../../../styles/admin-theme.wxss';

.profile-card {
  background: linear-gradient(135deg, #4a6cf7 0%, #3b5de7 100%);
  border-radius: var(--adm-radius-md);
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 108, 247, 0.25);
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.profile-info {
  flex: 1;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.profile-role {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: rgba(255,255,255,0.25);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
}

.profile-id {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

/* 菜单列表 */
.menu-list {
  background: var(--adm-card-bg);
  border-radius: var(--adm-radius-md);
  overflow: hidden;
  box-shadow: var(--adm-shadow);
}

.menu-item-row {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx solid var(--adm-border);
}

.menu-item-row:last-child {
  border-bottom: none;
}

.menu-item-row:active {
  background: #f8f9fb;
}

.menu-item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-item-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--adm-text-primary);
}

.menu-item-arrow {
  font-size: 36rpx;
  color: var(--adm-text-muted);
}

/* 退出登录 */
.logout-btn {
  margin-top: 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--adm-card-bg);
  border-radius: var(--adm-radius-lg);
  color: var(--adm-danger);
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: var(--adm-shadow);
}

.logout-btn:active {
  opacity: 0.7;
}
