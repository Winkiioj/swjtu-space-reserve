/* miniprogram/pages/seat/seat.wxss */
.container {
  padding: 20rpx;
}
.section {
  margin-bottom: 30rpx;
}
.lecture-grid {
  display: flex;
  flex-wrap: wrap;
}
.lecture-grid label {
  width: 45%;
  margin: 10rpx 2%;
}
.seat-card {
  background: #f5f5f5;
  margin: 20rpx 0;
  padding: 20rpx;
  border-radius: 10rpx;
}
.seat-card text {
  display: block;
}
.empty-tip {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}