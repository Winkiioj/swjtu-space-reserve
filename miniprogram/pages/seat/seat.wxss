/* ========== 全局 ========== */
.container {
  padding: 0 30rpx 40rpx;
  background: linear-gradient(180deg, #e8f8ee 0%, #f7f8fa 300rpx);
  min-height: 100vh;
}

/* ========== 顶部横幅 ========== */
.header-banner {
  display: flex;
  align-items: center;
  padding: 40rpx 0 30rpx;
}
.header-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}
.header-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.header-link {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border: 2rpx solid #07c160;
  border-radius: 30rpx;
  white-space: nowrap;
}
.header-link:active {
  background: #e8f8ee;
}
.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.3;
}
.header-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ========== 卡片区块 ========== */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

/* 区块头部 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.section-tip {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 12rpx;
  font-weight: 400;
}
.section-count {
  margin-left: auto;
  font-size: 26rpx;
  color: #07c160;
  font-weight: 500;
}

/* ========== 日期选择 ========== */
.date-group {
  display: flex;
  gap: 24rpx;
}
.date-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  border: 2rpx solid #f0f0f0;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.date-active {
  background: linear-gradient(135deg, #e8f8ee 0%, #f0fff4 100%);
  border-color: #07c160;
}
.date-radio {
  /* hidden visually but accessible */
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}
.date-info {
  display: flex;
  flex-direction: column;
}
.date-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.date-value {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.date-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #07c160;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 16rpx 0 16rpx;
}
.date-active .date-badge {
  background: #06ad56;
}

/* ========== 快捷选择时段栏 ========== */
.period-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.period-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #f7f8fa;
  border: 2rpx solid #f0f0f0;
  transition: all 0.2s;
}
.period-btn:active {
  transform: scale(0.96);
}
.period-active {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-color: #07c160;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.3);
}
.period-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}
.period-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.period-active .period-label {
  color: #fff;
}
.period-range {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}
.period-active .period-range {
  color: rgba(255,255,255,0.85);
}

/* ========== 讲次分组 ========== */
.lecture-section {
  border-top: 2rpx solid #f5f5f5;
  padding-top: 8rpx;
}
.lecture-group {
  margin-top: 20rpx;
}
.group-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
}
.group-range {
  font-size: 22rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.lecture-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.lecture-item {
  flex: 0 0 auto;
  min-width: calc(33.33% - 11rpx);
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fafafa;
  border: 2rpx solid #f0f0f0;
  transition: all 0.15s;
  box-sizing: border-box;
}
.lecture-checked {
  background: #e8f8ee;
  border-color: #07c160;
}
.lecture-checkbox {
  /* hide native checkbox, use custom style via parent */
  transform: scale(0.7);
  margin-right: 0;
}
.lecture-label {
  font-size: 26rpx;
  color: #444;
  margin-left: 4rpx;
  white-space: nowrap;
}
.lecture-checked .lecture-label {
  color: #07c160;
  font-weight: 500;
}

/* ========== 已选摘要 ========== */
.selection-summary {
  text-align: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}
.summary-label {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 500;
}

/* ========== 主按钮 ========== */
.search-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(7,193,96,0.35);
  border: none;
  padding: 0;
}
.search-btn:active {
  opacity: 0.9;
}

/* ========== 筛选区块 ========== */
.filter-section {
  border: 2rpx solid #e8f4fd;
}
.filter-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.filter-label {
  width: 80rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  color: #888;
  flex-shrink: 0;
}
.filter-options {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.filter-tag {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #f5f6fa;
  color: #555;
  border: 2rpx solid #eee;
  transition: all 0.15s;
  line-height: 1.4;
}
.filter-tag:active {
  transform: scale(0.95);
}
.filter-tag-active {
  background: linear-gradient(135deg, #1989fa 0%, #3f9eff 100%);
  color: #fff;
  border-color: #1989fa;
  box-shadow: 0 4rpx 16rpx rgba(25,137,250,0.25);
}
.filter-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #1989fa 0%, #3f9eff 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  margin-top: 12rpx;
  box-shadow: 0 6rpx 24rpx rgba(25,137,250,0.3);
  border: none;
  padding: 0;
}
.filter-btn:active {
  opacity: 0.9;
}

/* ========== 收藏按钮 ========== */
.fav-btn, .fav-btn-active {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
  padding: 0 24rpx;
  transition: all 0.15s;
}
.fav-btn {
  background: #fff;
  border: 2rpx solid #ff9800;
  color: #ff9800;
}
.fav-btn-active {
  background: linear-gradient(135deg, #ff9800 0%, #ffb74d 100%);
  border: 2rpx solid #ff9800;
  color: #fff;
}
.fav-btn:active, .fav-btn-active:active {
  opacity: 0.8;
  transform: scale(0.95);
}

/* ========== 座位网格 ========== */
.seat-section {
  padding-bottom: 20rpx;
}
.seat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.seat-card {
  width: calc(50% - 10rpx);
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fafafa;
  border: 2rpx solid #f0f0f0;
  transition: all 0.15s;
  box-sizing: border-box;
}
.seat-card:active {
  transform: scale(0.97);
  border-color: #07c160;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.15);
}
.seat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.seat-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.seat-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-free {
  background: #e8f8ee;
  color: #07c160;
}
.seat-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.seat-area {
  font-size: 26rpx;
  color: #888;
}
.seat-type {
  font-size: 24rpx;
  color: #bbb;
}

/* ========== 座位地图 ========== */
.map-section {
  overflow: hidden;
}
.map-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.map-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.map-legend {
  display: flex;
  gap: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #888;
}
.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}
.dot-free {
  background: #07c160;
}
.dot-occ {
  background: #e0e0e0;
}

/* 房间容器 */
.map-room {
  background: #fafbfc;
  border-radius: 20rpx;
  border: 2rpx solid #e8e8e8;
  overflow: hidden;
}

/* 上下墙壁 */
.room-wall {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}
.room-wall-top {
  background: linear-gradient(180deg, #e8f4fd 0%, transparent 100%);
  padding-bottom: 12rpx;
}
.room-wall-bottom {
  background: linear-gradient(0deg, #f5f0eb 0%, transparent 100%);
  padding-top: 12rpx;
}
.wall-line {
  flex: 1;
  height: 4rpx;
  background: #d0d0d0;
  border-radius: 2rpx;
}
.wall-window {
  font-size: 24rpx;
  color: #7ab8e0;
  margin: 0 20rpx;
  white-space: nowrap;
}
.wall-door {
  font-size: 24rpx;
  color: #b8956a;
  margin: 0 20rpx;
  white-space: nowrap;
}

/* 座位主体区域（左右墙 + 中间网格） */
.room-body {
  display: flex;
  align-items: stretch;
  padding: 20rpx 0;
}
.wall-side {
  width: 12rpx;
  margin: 0 16rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.wall-left {
  background: linear-gradient(180deg, #d0d0d0, #e0e0e0);
}
.wall-right {
  background: linear-gradient(180deg, #e0e0e0, #d0d0d0);
}

/* 座位网格 */
.room-grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 16rpx;
  justify-content: center;
}

/* 单个座位块 */
.room-seat {
  width: calc(33.33% - 11rpx);
  max-width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.seat-block {
  width: 100%;
  aspect-ratio: 1.2;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.seat-free .seat-block {
  background: linear-gradient(145deg, #07c160, #06ad56);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}
.seat-occ .seat-block {
  background: #f0f0f0;
  border: 2rpx solid #e0e0e0;
}
.seat-free:active .seat-block {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(7, 193, 96, 0.2);
}
.seat-block-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}
.seat-occ .seat-block-num {
  color: #bbb;
}
.seat-block-status {
  font-size: 20rpx;
  color: #999;
}
.seat-free .seat-block-status {
  color: #07c160;
}
.seat-occ .seat-block-status {
  color: #ccc;
}

/* 地图下方讲次提示 */
.map-lecture-hint {
  text-align: center;
  padding: 16rpx 0 20rpx;
  font-size: 24rpx;
  color: #bbb;
  border-top: 2rpx solid #f0f0f0;
  margin: 0 24rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #888;
  font-weight: 500;
}
.empty-hint {
  font-size: 26rpx;
  color: #ccc;
  margin-top: 10rpx;
}