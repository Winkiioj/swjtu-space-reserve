<view class="container">
  <!-- 顶部装饰头 -->
  <view class="header-banner">
    <view class="header-icon">📍</view>
    <view class="header-text">
      <text class="header-title">座位预约</text>
      <text class="header-subtitle">选择心仪的座位，高效学习</text>
    </view>
    <view class="header-link" bindtap="goToMyReservations">我的预约 ›</view>
  </view>

  <!-- 日期选择 -->
  <view class="section">
    <view class="section-header">
      <text class="section-icon">📅</text>
      <text class="section-title">预约日期</text>
    </view>
    <radio-group class="date-group" bindchange="onDateChange">
      <label class="date-card {{dayType === 'this' ? 'date-active' : ''}}">
        <radio value="this" checked="{{dayType === 'this'}}" class="date-radio"/>
        <view class="date-info">
          <text class="date-label">今天</text>
          <text class="date-value">{{todayDate}}</text>
        </view>
        <view class="date-badge">推荐</view>
      </label>
      <label class="date-card {{dayType === 'next' ? 'date-active' : ''}}">
        <radio value="next" checked="{{dayType === 'next'}}" class="date-radio"/>
        <view class="date-info">
          <text class="date-label">明天</text>
          <text class="date-value">{{tomorrowDate}}</text>
        </view>
      </label>
    </radio-group>
  </view>

  <!-- 讲次选择 — 三组平铺，始终可见 -->
  <view class="section">
    <view class="section-header">
      <text class="section-icon">🕐</text>
      <text class="section-title">选择讲次</text>
      <text class="section-tip">点击讲次选择或取消</text>
    </view>

    <!-- 上午组 -->
    <view class="period-group">
      <view class="period-head morning-head">
        <view class="period-head-left">
          <text class="period-icon">🌅</text>
          <text class="period-name">上午</text>
          <text class="period-range">08:00 - 12:25</text>
        </view>
        <view class="period-head-right">
          <text class="period-badge" wx:if="{{periodCounts.morning > 0}}">{{periodCounts.morning}}/5</text>
          <view class="period-toggle {{periodStates.morning ? 'toggle-on' : ''}}"
                bindtap="togglePeriod" data-period="morning">
            全选
          </view>
        </view>
      </view>
      <view class="lecture-row">
        <view wx:for="{{morningLectures}}" wx:key="index"
              class="lec-chip {{item.isSelected ? 'morning-chip-on' : ''}}"
              bindtap="onLectureChange" data-index="{{item.index}}">
          <text class="chip-label">{{item.label}}</text>
          <text class="chip-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- 下午组 -->
    <view class="period-group">
      <view class="period-head afternoon-head">
        <view class="period-head-left">
          <text class="period-icon">☀️</text>
          <text class="period-name">下午</text>
          <text class="period-range">14:00 - 18:15</text>
        </view>
        <view class="period-head-right">
          <text class="period-badge" wx:if="{{periodCounts.afternoon > 0}}">{{periodCounts.afternoon}}/5</text>
          <view class="period-toggle {{periodStates.afternoon ? 'toggle-on' : ''}}"
                bindtap="togglePeriod" data-period="afternoon">
            全选
          </view>
        </view>
      </view>
      <view class="lecture-row">
        <view wx:for="{{afternoonLectures}}" wx:key="index"
              class="lec-chip {{item.isSelected ? 'afternoon-chip-on' : ''}}"
              bindtap="onLectureChange" data-index="{{item.index}}">
          <text class="chip-label">{{item.label}}</text>
          <text class="chip-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- 晚上组 -->
    <view class="period-group">
      <view class="period-head evening-head">
        <view class="period-head-left">
          <text class="period-icon">🌙</text>
          <text class="period-name">晚上</text>
          <text class="period-range">19:30 - 21:55</text>
        </view>
        <view class="period-head-right">
          <text class="period-badge" wx:if="{{periodCounts.evening > 0}}">{{periodCounts.evening}}/3</text>
          <view class="period-toggle {{periodStates.evening ? 'toggle-on' : ''}}"
                bindtap="togglePeriod" data-period="evening">
            全选
          </view>
        </view>
      </view>
      <view class="lecture-row">
        <view wx:for="{{eveningLectures}}" wx:key="index"
              class="lec-chip {{item.isSelected ? 'evening-chip-on' : ''}}"
              bindtap="onLectureChange" data-index="{{item.index}}">
          <text class="chip-label">{{item.label}}</text>
          <text class="chip-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- 已选讲次摘要 -->
    <view wx:if="{{selectedLectures.length > 0}}" class="selection-summary">
      <text class="summary-label">已选 {{selectedLectures.length}} 个讲次</text>
    </view>
  </view>

  <!-- 查询按钮 -->
  <button class="search-btn" bindtap="searchSeats">
    <text wx:if="{{selectedLectures.length > 0}}">🔍 查询空闲座位（{{selectedLectures.length}}个讲次）</text>
    <text wx:else>🔍 查询空闲座位</text>
  </button>

</view>
