<!-- miniprogram/pages/seat/seat.wxml -->
<view class="container">
  <!-- 日期选择 -->
  <view class="section">
    <text class="section-title">预约日期</text>
    <radio-group class="radio-group" bindchange="onDateChange">
      <label class="radio-label">
        <radio value="this" checked/><text>今天（{{todayDate}}）</text>
      </label>
      <label class="radio-label">
        <radio value="next"/><text>明天（{{tomorrowDate}}）</text>
      </label>
    </radio-group>
  </view>

  <!-- 讲次分组选择：上午 / 下午 / 晚上 -->
  <view class="section">
    <text class="section-title">选择讲次（可多选）</text>
    <!-- 上午组 -->
    <view class="lecture-group">
      <view class="group-title">上午</view>
      <checkbox-group bindchange="onLectureChange">
        <view class="lecture-row">
          <label wx:for="{{morningLectures}}" wx:key="index" class="lecture-item">
            <checkbox value="{{item.index}}"/>
            <text>{{item.label}}</text>
          </label>
        </view>
      </checkbox-group>
    </view>
    <!-- 下午组 -->
    <view class="lecture-group">
      <view class="group-title">下午</view>
      <checkbox-group bindchange="onLectureChange">
        <view class="lecture-row">
          <label wx:for="{{afternoonLectures}}" wx:key="index" class="lecture-item">
            <checkbox value="{{item.index}}"/>
            <text>{{item.label}}</text>
          </label>
        </view>
      </checkbox-group>
    </view>
    <!-- 晚上组 -->
    <view class="lecture-group">
      <view class="group-title">晚上</view>
      <checkbox-group bindchange="onLectureChange">
        <view class="lecture-row">
          <label wx:for="{{eveningLectures}}" wx:key="index" class="lecture-item">
            <checkbox value="{{item.index}}"/>
            <text>{{item.label}}</text>
          </label>
        </view>
      </checkbox-group>
    </view>
  </view>

  <!-- 查询按钮 -->
  <button type="primary" bindtap="searchSeats">查询空闲座位</button>

  <!-- 楼层 + 区域筛选栏（仅当有座位数据时显示） -->
  <view wx:if="{{seatsRaw.length > 0}}" class="filter-section">
    <view class="filter-title">筛选楼层和区域</view>
    <!-- 楼层选择 -->
    <view class="filter-row">
      <text class="filter-label">楼层：</text>
      <view class="filter-options">
        <view wx:for="{{floors}}" wx:key="*this" 
              class="filter-tag {{currentFloor === item ? 'active' : ''}}"
              bindtap="selectFloor" data-floor="{{item}}">
          {{item}}楼
        </view>
      </view>
    </view>
    <!-- 区域选择（根据当前楼层显示） -->
    <view class="filter-row" wx:if="{{currentFloorAreas.length > 0}}">
      <text class="filter-label">区域：</text>
      <view class="filter-options">
        <view wx:for="{{currentFloorAreas}}" wx:key="*this"
              class="filter-tag {{currentArea === item ? 'active' : ''}}"
              bindtap="selectArea" data-area="{{item}}">
          {{item}}区
        </view>
      </view>
    </view>
    <!-- 确认筛选按钮 -->
    <button class="confirm-btn" bindtap="applyFilter">查看座位</button>
  </view>

  <!-- 座位列表展示 -->
  <view class="seat-list" wx:if="{{filteredSeats.length > 0}}">
    <view class="seat-card" wx:for="{{filteredSeats}}" wx:key="_id" bindtap="reserveSeat" data-seat="{{item}}">
      <text class="seat-id">{{item.seatID}}</text>
      <text class="seat-info">{{item.areaBelong}} · {{item.seatType === 'standard' ? '普通座' : item.seatType}}</text>
    </view>
  </view>
  <view wx:elif="{{seatsRaw.length > 0 && filteredSeats.length === 0}}" class="empty-tip">
    当前区域没有空闲座位，请选择其他区域
  </view>
  <view wx:elif="{{seatsRaw.length === 0 && queried}}" class="empty-tip">
    暂无空闲座位，请更换讲次或日期
  </view>
</view>