.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e8f4fd 0%, #ffffff 40%, #f0f5ff 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* ===== Logo 区域 ===== */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(22, 119, 255, 0.25);
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 12rpx;
}

.app-sub {
  font-size: 26rpx;
  color: #8c8c8c;
}

/* ===== 登录表单 ===== */
.login-box {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像选择区 */
.avatar-section {
  margin-bottom: 36rpx;
  display: flex;
  justify-content: center;
}

/* 圆形框 — view 画正圆 + 虚线边框，内放头像/占位图 */
.avatar-frame {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx dashed #d9d9d9;
  box-sizing: border-box;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  overflow: hidden;
}

/* 头像图片 */
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 占位提示 */
.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.avatar-icon {
  font-size: 48rpx;
  line-height: 1;
}
.avatar-hint {
  font-size: 20rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
  line-height: 1;
}

/* 透明 button 绝对定位覆盖整个圆 — 只做点击热区 */
.avatar-btn {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}
.avatar-btn::after {
  display: none;
}

/* 昵称输入区 */
.nickname-section {
  width: 100%;
  margin-bottom: 36rpx;
}

.nickname-input {
  width: 100%;
  height: 92rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  text-align: center;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  background: #c0c0c0;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 100rpx;
}

.login-btn::after {
  display: none;
}

.login-btn--active {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
}

/* ===== 开发环境：测试用户选择 ===== */
.dev-section {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fffbe6;
  border: 2rpx dashed #faad14;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.dev-label {
  font-size: 22rpx;
  color: #ad8b00;
  margin-bottom: 16rpx;
  text-align: center;
}

.dev-user-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.dev-user-chip {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid #e8e8e8;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  transition: all 0.2s;
}

.dev-user-chip--active {
  color: #1677ff;
  background: #e6f4ff;
  border-color: #1677ff;
  font-weight: 600;
}

.dev-real-link {
  font-size: 22rpx;
  color: #1677ff;
  text-align: center;
  margin-top: 16rpx;
  text-decoration: underline;
}

/* 提示文本 */
.hint {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 24rpx;
  text-align: center;
}
