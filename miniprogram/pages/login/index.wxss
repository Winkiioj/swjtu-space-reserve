.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e8f4fd 0%, #ffffff 40%, #f0f5ff 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* ===== Logo 区域 ===== */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(22, 119, 255, 0.25);
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 12rpx;
}

.app-sub {
  font-size: 26rpx;
  color: #8c8c8c;
}

/* ===== 登录表单 ===== */
.login-box {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像选择区 */
.avatar-section {
  margin-bottom: 36rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 4rpx dashed #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1;
}

.avatar-btn::after {
  display: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  border-radius: 50%;
}

.avatar-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.avatar-hint {
  font-size: 20rpx;
  color: #b0b0b0;
}

/* 昵称输入区 */
.nickname-section {
  width: 100%;
  margin-bottom: 36rpx;
}

.nickname-input {
  width: 100%;
  height: 92rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  text-align: center;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  background: #c0c0c0;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 100rpx;
}

.login-btn::after {
  display: none;
}

.login-btn--active {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
}

/* 提示文本 */
.hint {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 24rpx;
  text-align: center;
}
