<view class="page">
  <!-- Logo 区域 — 连点 3 次进入管理员登录 -->
  <view class="logo-area" bindtap="onLogoTap">
    <view class="logo-circle">🏫</view>
    <text class="app-name">交大空间预约</text>
    <text class="app-sub">教室租借 · 图书馆座位</text>
  </view>

  <!-- 登录表单区域 -->
  <view class="login-box">
    <!-- 头像选择 — view 画圆 + button 透明覆盖 -->
    <view class="avatar-section">
      <view class="avatar-frame">
        <image
          class="avatar-img"
          src="{{avatarUrl}}"
          mode="aspectFill"
          wx:if="{{avatarUrl}}"
        />
        <view class="avatar-placeholder" wx:else>
          <text class="avatar-icon">📷</text>
          <text class="avatar-hint">选头像</text>
        </view>
        <button
          class="avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        />
      </view>
    </view>

    <!-- 昵称输入 -->
    <view class="nickname-section">
      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickName}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        maxlength="20"
      />
    </view>

    <!-- 开发环境：测试用户快捷选择 -->
    <view class="dev-section" wx:if="{{isDev}}">
      <view class="dev-label">⚙️ 开发环境 — 模拟登录</view>
      <view class="dev-user-list">
        <view
          wx:for="{{devUsers}}"
          wx:key="value"
          class="dev-user-chip {{selectedDevUser === index ? 'dev-user-chip--active' : ''}}"
          data-index="{{index}}"
          bindtap="onSelectDevUser"
        >
          {{item.label}}
        </view>
      </view>
      <view
        class="dev-real-link"
        wx:if="{{selectedDevUser >= 0}}"
        bindtap="onUseRealLogin"
      >
        ← 切回真实微信登录
      </view>
    </view>

    <!-- 登录按钮 -->
    <button
      class="login-btn {{canLogin ? 'login-btn--active' : ''}}"
      bindtap="onLogin"
      loading="{{loading}}"
      disabled="{{!canLogin || loading}}"
    >
      <text wx:if="{{isDev && selectedDevUser >= 0}}">模拟登录 · {{devUsers[selectedDevUser].label}}</text>
      <text wx:else>微信一键登录</text>
    </button>

    <text class="hint">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>
