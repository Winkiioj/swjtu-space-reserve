/* 教室详情页 */
.page { min-height: 100vh; background: #f5f6fa; padding-bottom: 140rpx; }

/* 头部 */
.head {
  padding: 36rpx 32rpx; background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  color: #fff;
}
.head-name { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.head-meta { display: flex; gap: 24rpx; margin-bottom: 12rpx; }
.meta-item { font-size: 24rpx; opacity: 0.85; }
.head-desc { font-size: 24rpx; opacity: 0.7; line-height: 1.5; }

/* 周切换 */
.seg { display: flex; margin: 24rpx; }
.seg-item {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  background: #fff; color: #666; font-size: 28rpx; border-radius: 12rpx;
}
.seg-item.on { background: #1677ff; color: #fff; }
.seg-item:first-child { margin-right: 16rpx; }

/* 图例 */
.legend { display: flex; justify-content: center; gap: 32rpx; padding: 0 24rpx 16rpx; }
.leg-item { display: flex; align-items: center; font-size: 22rpx; color: #999; }
.leg-dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; margin-right: 8rpx; }
.leg-dot.free { background: #e6f7e6; border: 1rpx solid #b7eb8f; }
.leg-dot.course { background: #fff7e6; border: 1rpx solid #ffd591; }
.leg-dot.taken { background: #fff1f0; border: 1rpx solid #ffa39e; }

/* 矩阵 */
.matrix { margin: 0 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.mat-header { display: flex; background: #fafafa; border-bottom: 1rpx solid #f0f0f0; }
.mat-time-hd { width: 140rpx; }
.mat-day-hd {
  flex: 1; text-align: center; padding: 20rpx 0;
  font-size: 22rpx; color: #999; font-weight: 500;
}

.mat-body { max-height: 600rpx; }
.mat-row { display: flex; border-bottom: 1rpx solid #f8f8f8; }
.mat-row:last-child { border-bottom: none; }
.mat-time {
  width: 140rpx; display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 14rpx 8rpx; background: #fafafa;
}
.mat-t-label { font-size: 20rpx; color: #666; font-weight: 500; }
.mat-t-time { font-size: 18rpx; color: #bbb; margin-top: 2rpx; }

.mat-cell {
  flex: 1; min-height: 64rpx; display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #999;
}
.mat-cell.s0 { background: #f6ffed; } /* 空闲 */
.mat-cell.s1 { background: #fffbe6; color: #d48806; } /* 有课 */
.mat-cell.s2 { background: #fff2f0; color: #cf1322; } /* 已预约 */

/* 底部 */
.foot {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 16rpx; padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
}
.btn-fav {
  width: 180rpx; height: 88rpx; border-radius: 16rpx;
  background: #f5f5f5; color: #666; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.btn-fav.on { background: #fff7e6; color: #fa8c16; }
.btn-do {
  flex: 1; height: 88rpx; border-radius: 16rpx;
  background: #1677ff; color: #fff; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
