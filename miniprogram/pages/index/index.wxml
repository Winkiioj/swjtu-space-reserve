<view class="page">
  <!-- 用户卡片 -->
  <view class="user-bar" bindtap="onUserTap">
    <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
    <text wx:else class="avatar-place">🏫</text>
    <view class="user-text">
      <text class="user-name">{{nickName || '未登录'}}</text>
      <text class="user-id" wx:if="{{isBound}}">{{userID}}</text>
      <text class="user-id warn" wx:elif="{{isLoggedIn}}">请绑定学号</text>
      <text class="user-id" wx:else>点击登录</text>
    </view>
  </view>

  <!-- 未绑定引导 -->
  <view class="banner" wx:if="{{isLoggedIn && !isBound}}" bindtap="onBindBanner">
    <text class="banner-text">绑定学号/工号后可使用全部功能</text>
    <text class="banner-link">去绑定 ›</text>
  </view>

  <!-- 核心入口 — 两大功能卡片 -->
  <view class="grid">
    <view class="grid-item" bindtap="onFunc" data-type="classroom">
      <view class="grid-icon">🏫</view>
      <text class="grid-label">教室预约</text>
      <text class="grid-desc">借用空余教室</text>
      <view class="grid-btn">进入 ›</view>
    </view>
    <view class="grid-item seat-card" bindtap="onFunc" data-type="seat">
      <view class="grid-icon">💺</view>
      <text class="grid-label">图书馆座位</text>
      <text class="grid-desc">预约自习座位</text>
      <view class="grid-btn seat-btn">进入 ›</view>
    </view>
  </view>

  <!-- 使用指南 -->
  <view class="section">
    <text class="sec-title">使用指南</text>
    <view class="guide-cols">
      <!-- 教室预约流程 -->
      <view class="guide-col">
        <view class="guide-col-head classroom-head">
          <text class="guide-col-icon">🏫</text>
          <text class="guide-col-title">教室预约</text>
        </view>
        <view class="guide-steps">
          <view class="g-step" wx:for="{{classroomSteps}}" wx:key="num">
            <view class="g-step-num">{{item.num}}</view>
            <view class="g-step-text">
              <text class="g-step-title">{{item.title}}</text>
              <text class="g-step-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </view>
      <!-- 座位预约流程 -->
      <view class="guide-col">
        <view class="guide-col-head seat-head">
          <text class="guide-col-icon">💺</text>
          <text class="guide-col-title">座位预约</text>
        </view>
        <view class="guide-steps">
          <view class="g-step" wx:for="{{seatSteps}}" wx:key="num">
            <view class="g-step-num seat-num">{{item.num}}</view>
            <view class="g-step-text">
              <text class="g-step-title">{{item.title}}</text>
              <text class="g-step-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <text class="footer">西南交通大学 · 空间预约</text>
</view>
