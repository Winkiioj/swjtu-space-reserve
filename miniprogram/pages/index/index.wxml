<view class="page">
  <!-- 用户卡片 -->
  <view class="user-bar" bindtap="onUserTap">
    <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
    <text wx:else class="avatar-place">🏫</text>
    <view class="user-text">
      <text class="user-name">{{nickName || '未登录'}}</text>
      <text class="user-id" wx:if="{{isBound}}">{{userID}}</text>
      <text class="user-id warn" wx:elif="{{isLoggedIn}}">请绑定学号</text>
      <text class="user-id" wx:else>点击登录</text>
    </view>
  </view>

  <!-- 未绑定引导 -->
  <view class="banner" wx:if="{{isLoggedIn && !isBound}}" bindtap="onBindBanner">
    <text class="banner-text">绑定学号/工号后可使用借教室功能</text>
    <text class="banner-link">去绑定 ›</text>
  </view>

  <!-- 核心入口 -->
  <view class="grid">
    <view class="grid-item" bindtap="onFunc" data-type="classroom">
      <view class="grid-icon">🏫</view>
      <text class="grid-label">借教室</text>
    </view>
    <view class="grid-item" bindtap="onFunc" data-type="seat">
      <view class="grid-icon">💺</view>
      <text class="grid-label">图书馆座位</text>
    </view>
  </view>

  <!-- 使用指南 -->
  <view class="section">
    <text class="sec-title">使用指南</text>
    <view class="steps">
      <view class="step" wx:for="{{steps}}" wx:key="num">
        <view class="step-num">{{item.num}}</view>
        <view class="step-text">
          <text class="step-title">{{item.title}}</text>
          <text class="step-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <text class="footer">西南交通大学 · 空间预约</text>
</view>
