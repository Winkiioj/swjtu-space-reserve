.page { min-height: 100vh; background: #f5f6fa; padding-bottom: 48rpx; }

/* 用户卡片 */
.user-bar {
  display: flex; align-items: center;
  margin: 24rpx; padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  border-radius: 16rpx;
}

.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.avatar-place {
  width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}

.user-text { flex: 1; margin-left: 20rpx; }
.user-name { font-size: 32rpx; font-weight: 600; color: #fff; display: block; }
.user-id { font-size: 24rpx; color: rgba(255,255,255,0.7); display: block; margin-top: 6rpx; }
.user-id.warn { color: #ffe58f; }

/* 绑定引导 */
.banner {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 24rpx 24rpx; padding: 20rpx 24rpx;
  background: #fffbe6; border: 1rpx solid #ffe58f; border-radius: 12rpx;
}
.banner-text { font-size: 24rpx; color: #ad6800; }
.banner-link { font-size: 24rpx; color: #ad6800; font-weight: 600; flex-shrink: 0; }

/* 核心入口 */
.grid { display: flex; margin: 0 24rpx 24rpx; gap: 16rpx; }
.grid-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 32rpx 20rpx 24rpx; background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  transition: transform 0.15s;
}
.grid-item:active { transform: scale(0.97); }
.grid-icon { font-size: 56rpx; margin-bottom: 10rpx; }
.grid-label { font-size: 28rpx; color: #1a1a1a; font-weight: 600; margin-bottom: 4rpx; }
.grid-desc { font-size: 22rpx; color: #999; margin-bottom: 16rpx; }
.grid-btn {
  padding: 10rpx 40rpx; border-radius: 32rpx;
  background: #e6f4ff; color: #1677ff; font-size: 24rpx; font-weight: 500;
}
.seat-card .grid-btn {
  background: #e8f8ee; color: #07c160;
}

/* 使用指南 */
.section {
  margin: 0 24rpx 24rpx; padding: 24rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.sec-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; display: block; margin-bottom: 16rpx; }

/* 双栏布局 */
.guide-cols { display: flex; gap: 16rpx; }
.guide-col {
  flex: 1; min-width: 0;
  background: #fafbfc; border-radius: 14rpx;
  overflow: hidden;
}

/* 栏头 */
.guide-col-head {
  display: flex; align-items: center; gap: 8rpx;
  padding: 14rpx 18rpx;
}
.classroom-head { background: #e6f4ff; }
.seat-head { background: #e8f8ee; }
.guide-col-icon { font-size: 26rpx; }
.guide-col-title { font-size: 24rpx; font-weight: 600; }
.classroom-head .guide-col-title { color: #1677ff; }
.seat-head .guide-col-title { color: #07c160; }

/* 步骤列表 */
.guide-steps { padding: 10rpx 18rpx 14rpx; display: flex; flex-direction: column; }
.g-step { display: flex; align-items: flex-start; padding: 10rpx 0; }
.g-step-num {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: #e6f4ff; color: #1677ff; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 12rpx; margin-top: 2rpx;
}
.g-step-num.seat-num { background: #e8f8ee; color: #07c160; }
.g-step-text { flex: 1; min-width: 0; }
.g-step-title { font-size: 24rpx; font-weight: 600; color: #333; display: block; }
.g-step-desc { font-size: 20rpx; color: #8c8c8c; display: block; margin-top: 2rpx; }

.footer { text-align: center; font-size: 22rpx; color: #c0c0c0; padding: 16rpx 0; }
