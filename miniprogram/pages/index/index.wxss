.page { min-height: 100vh; background: #f5f6fa; padding-bottom: 48rpx; }

/* 用户卡片 */
.user-bar {
  display: flex; align-items: center;
  margin: 24rpx; padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  border-radius: 16rpx;
}

.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.avatar-place {
  width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}

.user-text { flex: 1; margin-left: 20rpx; }
.user-name { font-size: 32rpx; font-weight: 600; color: #fff; display: block; }
.user-id { font-size: 24rpx; color: rgba(255,255,255,0.7); display: block; margin-top: 6rpx; }
.user-id.warn { color: #ffe58f; }

/* 绑定引导 */
.banner {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 24rpx 24rpx; padding: 20rpx 24rpx;
  background: #fffbe6; border: 1rpx solid #ffe58f; border-radius: 12rpx;
}
.banner-text { font-size: 24rpx; color: #ad6800; }
.banner-link { font-size: 24rpx; color: #ad6800; font-weight: 600; flex-shrink: 0; }

/* 核心入口 */
.grid { display: flex; margin: 0 24rpx 24rpx; }
.grid-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 36rpx 0; background: #fff; border-radius: 16rpx;
  margin: 0 8rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: transform 0.15s;
}
.grid-item:first-child { margin-left: 0; }
.grid-item:last-child { margin-right: 0; }
.grid-item:active { transform: scale(0.97); }
.grid-icon { font-size: 52rpx; margin-bottom: 14rpx; }
.grid-label { font-size: 26rpx; color: #333; font-weight: 500; }

/* 使用指南 */
.section {
  margin: 0 24rpx 24rpx; padding: 24rpx;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.sec-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; display: block; margin-bottom: 20rpx; }

.steps { display: flex; flex-direction: column; }
.step { display: flex; align-items: flex-start; padding: 12rpx 0; }
.step-num {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #e6f4ff; color: #1677ff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 20rpx;
}
.step-text { flex: 1; }
.step-title { font-size: 26rpx; font-weight: 600; color: #333; display: block; }
.step-desc { font-size: 22rpx; color: #8c8c8c; display: block; margin-top: 4rpx; }

.footer { text-align: center; font-size: 22rpx; color: #c0c0c0; padding: 16rpx 0; }
